# test_tokenizer_gguf.mojo - the temporary GGUF vocab seam
# (src/tokenizer/gguf_vocab.mojo) against the checked-in tiny
# fixtures (tests/fixtures/, generated by
# tests/make_tiny_fixtures.py; see that script for the
# vocabulary design). Run from the mojo-engine/ directory so
# the fixture paths resolve, like every other suite here.
#
# Cases: the tiny file's metadata lands in TokenizerData
# exactly (model, pre, ids, counts, and a working tokenizer
# over it), a GGUF file with no tokenizer keys refuses with
# tokenizer_missing_vocab_metadata, a bad magic refuses with
# tokenizer_gguf_bad_magic, and a truncated file refuses with
# tokenizer_gguf_truncated (the two malformed files are written
# by this suite into /tmp, not checked in).

from std.testing import TestSuite, assert_true, assert_equal

from tokenizer.gguf_vocab import load_tokenizer_data
from tokenizer.tokenizer import Tokenizer


def test_tiny_gguf_metadata() raises:
    var data = load_tokenizer_data("tests/fixtures/tiny.gguf")
    assert_true(data.has_model)
    assert_equal(data.model, "gpt2")
    assert_true(data.has_pre)
    assert_equal(data.pre, "llama4")
    assert_equal(len(data.tokens), 519)
    assert_equal(len(data.token_types), 519)
    assert_equal(len(data.merges), 5)
    assert_equal(data.tokens[256], "<0x00>")
    assert_equal(data.tokens[518], "<|end_of_text|>")
    assert_equal(data.merges[0], "t h")
    assert_equal(data.bos_token_id, 518)
    assert_equal(data.eos_token_id, 518)
    assert_equal(data.unknown_token_id, 517)
    assert_equal(data.padding_token_id, -1)
    assert_true(not data.has_scores)


def test_tiny_gguf_tokenizer_works() raises:
    var data = load_tokenizer_data("tests/fixtures/tiny.gguf")
    var tok = Tokenizer.build(data^)
    assert_equal(tok.vocab_size(), 519)
    assert_equal(tok.family_name(), "gpt2")
    var ids = tok.encode(" the")
    assert_equal(len(ids), 1)
    assert_equal(ids[0], 514)
    assert_equal(tok.decode(ids), " the")
    var ids2 = tok.encode("café")
    assert_equal(len(ids2), 5)
    assert_equal(tok.decode(ids2), "café")


def test_missing_vocab_metadata_refused() raises:
    try:
        _ = load_tokenizer_data("tests/fixtures/notoken.gguf")
        assert_true(False, "a file with no tokens must refuse")
    except e:
        assert_true(
            String(e).find("tokenizer_missing_vocab_metadata") != -1,
            "refusal must name tokenizer_missing_vocab_metadata",
        )


def test_bad_magic_refused() raises:
    with open("/tmp/a5_tok_badmagic.gguf", "w") as f:
        f.write_bytes(
            List[UInt8](
                [
                    UInt8(0x58),  # 'X'
                    UInt8(0x58),
                    UInt8(0x58),
                    UInt8(0x58),
                    UInt8(3),
                    UInt8(0),
                    UInt8(0),
                    UInt8(0),
                ]
            )
        )
    try:
        _ = load_tokenizer_data("/tmp/a5_tok_badmagic.gguf")
        assert_true(False, "bad magic must refuse")
    except e:
        assert_true(
            String(e).find("tokenizer_gguf_bad_magic") != -1,
            "refusal must name tokenizer_gguf_bad_magic",
        )


def test_truncated_refused() raises:
    # A valid magic and version, then the file simply ends.
    with open("/tmp/a5_tok_truncated.gguf", "w") as f:
        f.write_bytes(
            List[UInt8](
                [
                    UInt8(0x47),  # 'G'
                    UInt8(0x47),
                    UInt8(0x55),  # 'U'
                    UInt8(0x46),  # 'F'
                    UInt8(3),
                    UInt8(0),
                    UInt8(0),
                    UInt8(0),
                ]
            )
        )
    try:
        _ = load_tokenizer_data("/tmp/a5_tok_truncated.gguf")
        assert_true(False, "a truncated file must refuse")
    except e:
        assert_true(
            String(e).find("tokenizer_gguf_truncated") != -1,
            "refusal must name tokenizer_gguf_truncated",
        )


def main() raises:
    TestSuite.discover_tests[__functions_in_module()]().run()
